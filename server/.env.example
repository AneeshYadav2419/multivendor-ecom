# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/multivendor_db

# ── Auth Secrets (generate with: openssl rand -base64 64) ─
# Use SEPARATE secrets for access and refresh tokens
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
